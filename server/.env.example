# ============================================================================
# Variáveis de ambiente do Servidor — Central de Operadores (HSV)
#
# IMPORTANTE: o servidor NÃO carrega este arquivo automaticamente (não há
# python-dotenv). Este é um TEMPLATE de referência: ele documenta TODAS as
# variáveis que o servidor honra. Defina as que precisar no AMBIENTE do sistema
# (no Windows: setx NOME "valor") ou, para a maioria, em data/server_config.json.
#
# Segredos (TASY_SECRET_KEY, TASY_SMTP_SENHA) devem ficar SÓ no ambiente —
# nunca comitados. Copie para .env apenas se um dia adotar python-dotenv.
# ============================================================================

# ── Servidor ────────────────────────────────────────────────────────────────
TASY_HOST=0.0.0.0
TASY_PORT=5000
TASY_DEBUG=false
TASY_ENV=production

# ── Segurança ───────────────────────────────────────────────────────────────
# Chave de assinatura da sessão. Gere uma forte (ex.: python -c "import secrets;print(secrets.token_hex(32))").
TASY_SECRET_KEY=gere-uma-chave-secreta-forte
# Origens permitidas no CORS (separadas por vírgula). Em produção, restrinja.
TASY_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*

# ── Banco de dados ──────────────────────────────────────────────────────────
TASY_DB_PATH=data/operadores.db

# ── Logging ─────────────────────────────────────────────────────────────────
TASY_LOG_LEVEL=INFO
TASY_LOG_FILE=logs/server.log

# ── E-mail / SMTP (redefinição de senha por link e alertas críticos) ─────────
# Usado com a conta noreply.central.operadores@gmail.com (Gmail exige Senha de app).
TASY_SMTP_SERVIDOR=smtp.gmail.com
TASY_SMTP_PORTA=587
TASY_SMTP_TLS=true
TASY_SMTP_USUARIO=noreply.central.operadores@gmail.com
TASY_SMTP_REMETENTE=noreply.central.operadores@gmail.com
# A SENHA fica SÓ no ambiente (setx TASY_SMTP_SENHA "..."). Deixe vazio aqui.
TASY_SMTP_SENHA=

# ── Monitor do host do Tasy (faz uma requisição HTTP e checa se o Tasy responde) ──
# Não é só TCP: sonda GET https://<host><caminho> e considera "no ar" só com
# status < 500. Assim uma queda de aplicação (proxy aceitando a porta, app fora)
# é detectada — um TCP simples deixava passar.
TASY_MONITOR_ENABLED=true
TASY_MONITOR_HOST=tasy.hospitalsaovicente.org.br
TASY_MONITOR_PORTA=443
TASY_MONITOR_CAMINHO=/           # caminho testado (ex.: "/" ou "/login")
TASY_MONITOR_INTERVALO_S=30      # de quanto em quanto tempo testa
TASY_MONITOR_TIMEOUT_S=8         # timeout de cada requisição HTTP
TASY_MONITOR_FALHAS=3            # falhas seguidas para declarar indisponível
TASY_MONITOR_SUCESSOS=4          # sucessos seguidos para declarar restabelecido (anti-flapping)

# ── Detecção de incidentes por unidade (alertas pelos painéis) ───────────────
TASY_ALERT_JANELA_S=120          # janela para agrupar sinais de um painel
TASY_ALERT_MIN_PAINEIS=3         # nº mínimo de painéis distintos para abrir incidente
TASY_ALERT_PCT=0.30              # ou este % dos painéis conectados da unidade
TASY_ALERT_CONSOLIDACAO_S=30     # espera para juntar afetados antes do 1º e-mail
TASY_ALERT_SILENCIO_S=600        # silêncio que encerra o incidente (10 min; num Tasy instável o
                                 # incidente fica aberto em vez de abrir/recuperar em ciclos)
TASY_ALERT_COOLDOWN_S=300        # após encerrar, não reabre na mesma unidade por 5 min (anti-flapping)
TASY_ALERT_GRACA_BOOT_S=90       # ignora sinais logo após o servidor subir
TASY_ALERT_TICK_S=5              # frequência de revisão dos incidentes
