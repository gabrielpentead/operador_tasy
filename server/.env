# Configurações do Servidor Painel de Senhas HSV
# Copie este arquivo para .env e ajuste os valores conforme necessário

# Configurações do Servidor
TASY_HOST=127.0.0.1
TASY_PORT=5000
TASY_DEBUG=true
TASY_ENV=development

# Segurança
TASY_SECRET_KEY=your-secret-key-here-generate-a-secure-one
TASY_CORS_ORIGINS=http://localhost:*,http://127.0.0.1:*,http://172.16.28.70:*

# Logging
TASY_LOG_LEVEL=INFO
TASY_LOG_FILE=logs/server.log

# Banco de Dados
TASY_DB_PATH=data/operadores.db

# Observações:
# - Gere uma chave secreta segura para TASY_SECRET_KEY
# - Em produção, configure TASY_CORS_ORIGINS com domínios específicos
# - Para desenvolvimento, use TASY_DEBUG=true e TASY_ENV=development production
